rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) 
        && request.resource.data.keys().hasAll(['uid', 'email', 'createdAt'])
        && request.resource.data.keys().size() == 3;
    }

    // Generic validation for shared fields (userId)
    function validateUserId() {
      return request.resource.data.userId == request.auth.uid;
    }

    // Products collection
    match /products/{productId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && validateUserId() && isValidId(productId);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && validateUserId();
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Campaigns collection
    match /campaigns/{campaignId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && validateUserId() && isValidId(campaignId);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && validateUserId();
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Planning History collection
    match /planning_history/{historyId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && validateUserId() && isValidId(historyId);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
