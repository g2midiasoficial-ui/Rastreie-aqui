rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return (isSignedIn() && request.auth.uid == userId) || userId == 'public_user';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Generic validation for shared fields (userId)
    function validateUserId(data) {
      return (isSignedIn() && data.userId == request.auth.uid) || data.userId == 'public_user';
    }

    // Products collection
    match /products/{productId} {
      allow list: if isPublicOrOwner(resource.data.userId);
      allow get: if isPublicOrOwner(resource.data.userId);
      allow create: if validateUserId(request.resource.data) && isValidId(productId);
      allow update: if isPublicOrOwner(resource.data.userId) && validateUserId(request.resource.data);
      allow delete: if isPublicOrOwner(resource.data.userId);
    }

    // Campaigns collection
    match /campaigns/{campaignId} {
      allow list: if isPublicOrOwner(resource.data.userId);
      allow get: if isPublicOrOwner(resource.data.userId);
      allow create: if validateUserId(request.resource.data) && isValidId(campaignId);
      allow update: if isPublicOrOwner(resource.data.userId) && validateUserId(request.resource.data);
      allow delete: if isPublicOrOwner(resource.data.userId);
    }

    // Planning History collection
    match /planning_history/{historyId} {
      allow list: if isPublicOrOwner(resource.data.userId);
      allow create: if validateUserId(request.resource.data) && isValidId(historyId);
      allow delete: if isPublicOrOwner(resource.data.userId);
    }

    function isPublicOrOwner(userId) {
      return userId == 'public_user' || (isSignedIn() && request.auth.uid == userId);
    }
  }
}
